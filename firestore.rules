rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Le compte "worker" (utilisé par GitHub) : remplace le texte entre guillemets par son UID.
    function isWorker() {
      return request.auth != null && request.auth.uid == "REMPLACE_PAR_UID_WORKER";
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isWorker();
    }
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid) || isWorker();
    }
  }
}
